# Core runtime
DATABASE_URL=postgresql://user:password@localhost:5432/roleradar
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Sign-in. AUTH_SECRET signs the session cookie; without it no session can be issued
# or read, and every sign-in surface says so instead of pretending to work.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Public origin used to build each provider's redirect URI. Falls back to NEXT_PUBLIC_APP_URL.
AUTH_PUBLIC_URL=http://localhost:3000
# Hosted Sign in with ChatGPT. The /signin-with-chatgpt route is served by the OpenAI
# hosting dispatch, not by this app, so the button is hidden unless this is true.
AUTH_CHATGPT_ENABLED=false
# Social providers. A provider is offered only when both its id and secret are present.
# Register the callback URL <AUTH_PUBLIC_URL>/api/auth/<provider>/callback with each one.
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# LinkedIn: https://www.linkedin.com/developers/apps (product "Sign In with LinkedIn using OpenID Connect")
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Microsoft: https://entra.microsoft.com (App registrations)
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps (Facebook Login)
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

# Supabase production adapter (demo mode is used when omitted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_CV_BUCKET=roleradar-private-cvs

# AI provider abstraction. Shared by Reactive Resume (CV parsing and tailoring) and the
# NextJOB document writer (cover letter, email, interview prep), which needs an
# OpenAI-compatible chat-completions API: openai, openrouter, groq, mistral, deepseek,
# togetherai, fireworks, cerebras, perplexity, xai, ollama, or openai-compatible + AI_BASE_URL.
AI_PROVIDER=openai-compatible
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_PROMPT_VERSION=application-grounded-1.0
AI_GENERATION_HOURLY_LIMIT=10

# Email and WhatsApp adapters
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=RoleRadar <alerts@example.com>
WHATSAPP_PROVIDER=demo
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WEBHOOK_SIGNING_SECRET=

# Queue and live job ingestion
QUEUE_PROVIDER=demo
QUEUE_URL=
GREENHOUSE_BOARD_TOKENS=awin,nozominetworks,armissecurity,planradar,autoscout24,saasgroup,goodnotes,fasthosts,eu:growe,eu:idnow,eu:nlighten,eu:soficonv,eu:convera,eu:ancoris
LEVER_SITES=eu:prima,eu:optotune,global:researchgate,global:reply,global:musixmatch
# Employer boards with Italian hiring, each verified to answer its public feed. "none" disables a family.
ASHBY_ORGS=satispay,docebo,serenis
WORKABLE_ACCOUNTS=moneyfarm
RECRUITEE_COMPANIES=
# SmartRecruiters: company identifier, optionally :Label; only SMARTRECRUITERS_MARKETS (ISO codes) are read.
SMARTRECRUITERS_COMPANIES=BoschGroup:Bosch,Continental,ServiceNow,Wabtec,AveryDennison:Avery Dennison
SMARTRECRUITERS_MARKETS=IT
# Personio: the {company}.jobs.personio.de subdomain; prefix com: for a .com tenant.
PERSONIO_COMPANIES=holidu
# EURES explicitly prohibits scraping and restricts its API to recognized partners.
EURES_PARTNER_API_URL=
EURES_PARTNER_API_TOKEN=
# Exact administrator-approved HTTPS job pages containing JobPosting JSON-LD.
# The crawler checks robots.txt and never accepts URLs from public requests.
# Indeed and LinkedIn URLs are rejected; their listings require authorized partner access.
CRAWLER_JOB_URLS=
PROVIDER_REQUESTS_PER_MINUTE=30
NEXTJOB_DISABLE_LIVE_JOBS=false

# With AI_PROVIDER=openai, PDF/DOCX extraction calls the configured model directly
# and stores reviewed CV data privately. Reactive Resume is optional for this path.
# Other AI providers use Reactive Resume for extraction. Its key is never exposed to the browser.
# Create the key at https://rxresu.me/dashboard/settings/api-keys.
# CV parsing also requires AI_PROVIDER, AI_PROVIDER_API_KEY, and AI_MODEL above.
REACTIVE_RESUME_API_KEY=

# Limits, retention, and flags
CV_MAX_BYTES=10485760
DATA_RETENTION_DAYS=365
FEATURE_WHATSAPP_ALERTS=false
FEATURE_BILLING=false
FEATURE_DEMO_MODE=false

# One-time tailored CV downloads. Set STRIPE_SECRET_KEY in the Site secret store
# to enable the fixed €1.50 Checkout flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure checkout.session.completed at /api/payments/webhook in Stripe.
PAYMENTS_PUBLIC_ORIGIN=
